# Copy to .env and fill in. Never commit .env.

# --- The bot's wallet: the same address on both chains ---
# Needs: PLS for gas and a float of USDC (bridged from Ethereum) on PulseChain, to pay for the names
# it registers; a little ETH on Ethereum, to claim bridge messages (a few cents each).
BOT_PRIVATE_KEY=
# Opens the sealed details of each order. Make one with: npm run keygen
BOT_ENCRYPTION_SECRET_KEY=
# Who the order book pays on Ethereum. Defaults to the bot's wallet.
# PAYEE=

# --- Contracts: from the deploy workflow's job summaries ---
PULSECHAIN_REGISTRAR=
PULSECHAIN_HEX_REGISTRY=
PULSECHAIN_ORDER_FILLER=
PULSECHAIN_MIRROR_SYNC=
ETHEREUM_ORDER_BOOK=
ETHEREUM_MIRROR_REGISTRAR=

# --- Optional ---
# PULSECHAIN_RPC_URL=https://rpc.pulsechain.com
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# The least fee the bot takes per order, in USDC. Websites must add at least this to the price.
# MIN_FEE_USDC=0.25
# Ethereum blocks to wait before acting on an order (12 seconds each).
# ETHEREUM_CONFIRMATIONS=2
# POLL_SECONDS=5
# STATE_FILE=./state.json
# Where to start reading on a first run: the blocks the contracts were deployed in.
# START_BLOCK_ETHEREUM=
# START_BLOCK_PULSECHAIN=
# Turn parts off: FILL=false, RELAY=false, SYNC=false
