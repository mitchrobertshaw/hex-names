# Copy to .env and fill in. Never commit .env.

# --- Which network ---
# mainnet (PulseChain + Ethereum), or testnet (PulseChain Testnet v4 + Sepolia). Use a separate
# .env, wallet and state file for each.
NETWORK=mainnet

# --- The bot's wallet: the same address on both chains ---
# Needs, once: PLS for gas and a float of USDC (bridged from Ethereum) on PulseChain, to pay for the
# names it registers; a little ETH on Ethereum, to claim bridge messages (a few cents each). After
# that it buys its own gas and refills its own float (see TREASURY below).
BOT_PRIVATE_KEY=
# Optional. Opens the sealed details of each order. Leave it out and the bot makes it from
# BOT_PRIVATE_KEY, printing the public key (for the website) when it starts. To keep the two
# separate, make one with: npm run keygen
# BOT_ENCRYPTION_SECRET_KEY=

# --- Contracts: from the deploy workflow's job summaries ---
PULSECHAIN_REGISTRAR=
PULSECHAIN_HEX_REGISTRY=
PULSECHAIN_ORDER_FILLER=
PULSECHAIN_MIRROR_SYNC=
ETHEREUM_ORDER_BOOK=
ETHEREUM_MIRROR_REGISTRAR=
# Where to start reading on a first run: START_BLOCK_PULSECHAIN from step 1, START_BLOCK_ETHEREUM
# from step 2.
START_BLOCK_PULSECHAIN=
START_BLOCK_ETHEREUM=
# On the testnet only: "USDC from Sepolia", PULSECHAIN_USDC from step 1. (On mainnet it is USDC
# bridged from Ethereum, filled in for you.)
# PULSECHAIN_USDC=

# --- Optional ---
# RPCs. Defaults: rpc.pulsechain.com and ethereum-rpc.publicnode.com on mainnet,
# rpc.v4.testnet.pulsechain.com and ethereum-sepolia-rpc.publicnode.com on the testnet.
# PULSECHAIN_RPC_URL=
# ETHEREUM_RPC_URL=
# The least fee the bot takes per order, in USDC. Websites must add at least this to the price.
# MIN_FEE_USDC=0.25
# Ethereum blocks to wait before acting on an order (12 seconds each).
# ETHEREUM_CONFIRMATIONS=2
# POLL_SECONDS=5
# Where it remembers its place. On Railway it uses the attached volume by itself.
# STATE_FILE=./state.json
# Turn parts off: FILL=false, RELAY=false, SYNC=false, TREASURY=false
# Its money (TREASURY): the float it keeps on PulseChain, and when and how much gas it buys.
# Mainnet defaults shown; the testnet's are smaller. Anything over FLOAT_USDC (plus a fifth) goes to
# the payments wallet; short of it, it draws from the payments wallet's budget, set in the app.
# FLOAT_USDC=150
# PLS_LOW=200000
# PLS_BUY_USDC=2
# ETH_LOW=0.003
# ETH_BUY_USDC=15
